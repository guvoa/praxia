# Praxia — variables de entorno
# Copia este archivo como .env y ajusta los valores. .env NO se versiona.

# Aplicación
APP_NAME=Praxia
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/praxia
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es

# Base de datos (MySQL/MariaDB de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=praxia
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Sesión
SESSION_NAME=praxia_session
SESSION_LIFETIME=120

# Subida de archivos (en MB)
UPLOAD_MAX_SIZE=5
